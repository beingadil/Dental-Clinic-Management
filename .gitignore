# Dependencies
node_modules/

# Build output
dist/
build/
coverage/

# Tauri / Rust build artifacts (regenerated from src-tauri/)
src-tauri/target/

# Tauri-generated capability schemas (src-tauri/gen/, ~330 KB of JSON).
# tauri-build regenerates all four files on every `tauri build` / `tauri dev`,
# so tracking them only produces merge noise. The "$schema" line in
# capabilities/default.json points at desktop-schema.json purely so editors
# autocomplete the permission names; if the file is absent the build recreates
# it and only IDE hints are lost.
src-tauri/gen/

# Runtime application data — NEVER commit clinic data
*.sqlite
*.sqlite3
*.sqlite.bak
*.sqlite.tmp
*.db
*.dentalbackup
*.dentalupdate
backups/

# Environment / secrets — nothing env-related EVER goes to GitHub
# (includes .env.example, .env.local, *.env, every variant)
.env
.env.*
.env*
*.env

# Logs
*.log
npm-debug.log*

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE / agent tooling
.vscode/
.idea/
*.swp
.freebuff
.freebuff*
*freebuff*

# Temporary
tmp/
*.tmp

# Local contrast-audit report (scripts/contrast-audit.mjs). CI writes its own
# copy as an artifact; a local run should not leave one in the tree.
contrast-audit.txt

# Quarantined files kept for security analysis (never commit)
.quarantine/

# Agent working notes and design rationale � internal only, never shipped.
# .planning/2026-10-06-backup-restore/audit.md was previously tracked; untracked so the
# repo carries shipped code only.
.planning/
DESIGN.md

# Locally installed agent skills (brag, brag-slim). 16 MB of bundled audio
# assets per install, and regenerable via the skills CLI.
# Only the skills dir is ignored, so a tracked .opencode/opencode.json still works.
.opencode/skills/

# /brag output - rendered launch videos, storyboards, plans, and share copy.
# Covers both brag-output/ and the timestamped brag-output-YYYY-MM-DD-HHMMSS/
# the skill writes to avoid clobbering earlier runs, plus any stray render
# dropped elsewhere in the tree. Generated media, never committed.
brag-output*/
brag.mp4

# Hackathon submission assets - screenshots, the explainer video and the
# profile README. These are published to Google Drive and referenced by URL
# rather than committed: the video is ~4.6 MB and the screenshots add ~4 MB
# of binaries that a reviewer never needs to clone.
hackathon-assets/