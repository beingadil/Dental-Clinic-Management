{
  "name": "dental-solutions",
  "private": true,
  "version": "2.30.2",
  "type": "module",
  "scripts": {
    "dev": "node scripts/verify-binaries.mjs && npm run role:check && vite --port=3000 --host=0.0.0.0",
    "build": "node scripts/verify-binaries.mjs && npm run role:check && vite build",
    "preview": "vite preview",
    "test": "node scripts/verify-binaries.mjs && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "lint": "node scripts/version-guard.mjs && npm run verify:binaries && node scripts/role-picker.mjs --check && tsc --noEmit",
    "verify:binaries": "node scripts/verify-binaries.mjs",
    "audit:contrast": "node scripts/contrast-audit.mjs",
    "audit:darkbar": "node scripts/find-darkbar-ink.mjs",
    "audit:inline-bg": "node scripts/audit-inline-bg.mjs",
    "role:write": "node scripts/role-picker.mjs --write",
    "role:check": "node scripts/role-picker.mjs --check",
    "hooks:install": "node scripts/install-hooks.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "theme:check": "npm run role:check && npm run audit:contrast && npm run audit:darkbar && npm run audit:inline-bg",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "icons": "node scripts/generate-icons.mjs && node -e \"require('sharp')('public/icon.svg',{density:300}).resize(1024,1024).png().toFile('public/icons/icon-1024.png').then(()=>console.log('done'))\" && npx tauri icon public/icons/icon-1024.png -o src-tauri/icons",
    "vendor-fonts": "node scripts/vendor-fonts.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.10.1",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^25.0.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite": "^6.4.5",
    "vitest": "^5.0.3"
  },
  "overrides": {
    "source-map-js": "^1.2.2"
  }
}
